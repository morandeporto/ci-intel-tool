# Copy to .env and fill in real values. Never commit .env.
# Provider: Google Gemini (free-tier friendly for this assignment)

GEMINI_API_KEY=your-gemini-api-key-here

# Leave blank / placeholder to use local SQLite (data/ci_intel.db).
TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Optional: force a local SQLite path when Turso is not configured.
# Ignored when TURSO_DATABASE_URL + TURSO_AUTH_TOKEN are set (shared demo DB wins).
# Useful for pointing tests or a second local DB at a custom file.
# CI_INTEL_DB=data/ci_intel.db
